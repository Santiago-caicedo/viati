# ===== Django =====
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# En producción, ej: https://www.viaticafe.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# URL pública del sitio, con https y SIN "/" final. Mercado Pago usa esta URL
# para el webhook y el retorno: debe ser el dominio FINAL (ej. con www si el
# dominio sin www redirige), porque Mercado Pago no sigue redirecciones.
SITE_URL=http://localhost:8000

# Base de datos (vacío = SQLite local). En producción PostgreSQL:
# postgres://usuario:contraseña@host:5432/viati
DATABASE_URL=

# ===== Correo =====
# Proveedor de correo: smtp (Gmail / Google Workspace) o resend
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=gerencia@agroambientec.com
# Contraseña de APLICACIÓN de Google (16 letras), no la contraseña normal
EMAIL_HOST_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=Viati Café <gerencia@agroambientec.com>
EMAIL_GERENCIA=gerencia@agroambientec.com
# true = no envía correos reales, los guarda en tmp_emails/ (por defecto true si DEBUG)
EMAIL_DRY_RUN=true

# ===== Mercado Pago =====
# Usa credenciales de PRUEBA en desarrollo (empiezan por TEST-).
MP_ACCESS_TOKEN=
# Clave secreta de webhooks (panel de Mercado Pago → Webhooks). Recomendada.
MP_WEBHOOK_SECRET=

# ===== Google Analytics 4 =====
GA_MEASUREMENT_ID=

# ===== Odoo (opcional: sincronización automática del catálogo) =====
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=
ODOO_PRICELIST=Precios Web
# Sincronización automática con Odoo al visitar la tienda: cada cuántos minutos (0 = apagada).
# Solo funciona si los 4 datos ODOO_* de arriba están completos.
ODOO_SYNC_MINUTOS=0
# true = ocultar también los productos que no vienen de Odoo
ODOO_SYNC_SOLO_ODOO=false
